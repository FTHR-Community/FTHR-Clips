#!/bin/bash
set -e

HERE="$(dirname "$(readlink -f "$0")")"

# C++ engine ships inside the AppImage
export FTHR_ENGINE="$HERE/usr/bin/FTHRclips"

# Use system Python — PyQt6 + Qt6 are system-linked and must stay consistent.
# We only ship the Python app source and the C++ binary inside the AppImage.
PYTHON="$(command -v python3 2>/dev/null || command -v python 2>/dev/null)"
if [ -z "$PYTHON" ]; then
    echo "ERROR: python3 not found. Install Python 3.10+ to run FTHR Clips."
    exit 1
fi

# Check required Python packages
"$PYTHON" -c "import PyQt6, keyboard, cv2, imageio_ffmpeg" 2>/dev/null || {
    echo "ERROR: Missing Python dependencies."
    echo "Install them with:"
    echo "  pip install PyQt6 keyboard opencv-python-headless imageio-ffmpeg sounddevice numpy"
    echo ""
    echo "On Arch: sudo pacman -S python-pyqt6 && pip install keyboard imageio-ffmpeg sounddevice"
    exit 1
}

# Auto-detect Wayland vs X11
if [ -n "$WAYLAND_DISPLAY" ]; then
    export QT_QPA_PLATFORM="wayland"
elif [ -n "$DISPLAY" ]; then
    export QT_QPA_PLATFORM="xcb"
fi

export PYTHONUNBUFFERED=1
exec "$PYTHON" "$HERE/usr/share/fthr-clips/FTHR_UI/main.py" "$@"
